{
	"name": "obsidian-pulsar-graph",
	"version": "1.15.0",
	"description": "Temporal visualization for Obsidian's graph view - fade nodes by modification time",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"type-check": "tsc --noEmit"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"graph-view",
		"visualization",
		"temporal"
	],
	"author": "Lucas-Liona",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^20.19.43",
		"esbuild": "0.17.3",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0"
	}
}
