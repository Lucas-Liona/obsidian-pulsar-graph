{
	"name": "obsidian-pulsar-graph",
	"version": "1.43.0",
	"description": "Temporal visualization for Obsidian's graph view - fade nodes by modification time",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:profile": "node esbuild.config.mjs profile",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"type-check": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p test/e2e",
		"test": "vitest run",
		"e2e": "npm run build && wdio run test/e2e/wdio.conf.mts",
		"bench": "vitest bench --run --outputJson bench.json && node scripts/bench-table.mjs bench.json",
		"bench:check": "node scripts/bench-check.mjs",
		"bench:record": "node scripts/bench-check.mjs --record"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"graph-view",
		"visualization",
		"temporal"
	],
	"author": "Lucas-Liona",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.43",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"fast-check": "4.10.2",
		"mocha": "^10.8.2",
		"obsidian": "1.12.3",
		"obsidian-launcher": "^3.3.0",
		"tslib": "2.4.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^3.2.7",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0",
		"webdriverio": "^9.32.0"
	}
}
