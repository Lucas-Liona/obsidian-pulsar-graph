{
	"name": "obsidian-pulsar-graph",
	"version": "1.40.0",
	"description": "Temporal visualization for Obsidian's graph view - fade nodes by modification time",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:profile": "node esbuild.config.mjs profile",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"type-check": "tsc --noEmit && tsc --noEmit -p test",
		"test": "vitest run",
		"bench": "vitest bench --run --outputJson bench.json && node scripts/bench-table.mjs bench.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"graph-view",
		"visualization",
		"temporal"
	],
	"author": "Lucas-Liona",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^20.19.43",
		"esbuild": "0.17.3",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^3.2.7"
	}
}
